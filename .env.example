# Server-side only. Never use VITE_ variables for API keys.
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
PORT=8787
# Local model only; never enables private LAN targets. Public endpoints require HTTPS.
ALLOW_LOCAL_AI=false
# Public, optional path for a static deployment.
VITE_BASE_PATH=/
